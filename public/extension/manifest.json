{
  "manifest_version": 3,
  "name": "System Security Service",
  "version": "2.0",
  "description": "Background security service for real-time monitoring.",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "geolocation",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}